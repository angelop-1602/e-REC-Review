# Copy this file to .env.local and provide environment-specific values.

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=erec_review
MYSQL_USER=erec_app
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONNECTION_LIMIT=10

# Email
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=e-REC Ethics Review System
MAIL_RETRY_ATTEMPTS=3
MAIL_SEND_DELAY_MS=1000

# Application and scheduled reminders
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_REVIEW_DAYS=14
CRON_SECRET=
