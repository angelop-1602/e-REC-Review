{
  "name": "e-rec-reviews",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "backup:firestore:verify": "node scripts/verify-firestore-backup.mjs",
    "backup:firestore:verify-managed": "node scripts/verify-firestore-managed-backup.mjs",
    "db:mysql:up": "docker compose --env-file .env.local -f compose.mysql.yml up -d --wait mysql",
    "db:mysql:down": "docker compose --env-file .env.local -f compose.mysql.yml down",
    "db:mysql:status": "docker compose --env-file .env.local -f compose.mysql.yml ps",
    "db:mysql:migrate": "node --env-file=.env.local scripts/apply-mysql-migrations.mjs",
    "db:mysql:import": "node --env-file=.env.local scripts/import-firestore-to-mysql.mjs",
    "db:mysql:verify": "node --env-file=.env.local scripts/verify-mysql-import.mjs"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.3.16",
    "@vercel/speed-insights": "^1.2.0",
    "@xmldom/xmldom": "^0.8.11",
    "chart.js": "^4.4.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jszip": "^3.10.1",
    "mysql2": "^3.23.3",
    "next": "15.3.8",
    "nodemailer": "^9.0.1",
    "papaparse": "^5.5.2",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^1.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
